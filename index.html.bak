<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#0a0e1a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Signal Lost">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="application-name" content="Signal Lost">
  <title>Signal Lost v2</title>
  <link rel="manifest" href="manifest.json">
  <link rel="apple-touch-icon" href="icon-192.png">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <link rel="stylesheet" href="styles-v2.css?v=3">
  <script>
    // Splash dismiss failsafe — runs before game-v2.js loads
    // This is the PRIMARY splash handler on mobile. game-v2.js may arrive late or not at all.
    (function() {
      var failSafeFired = false;

      function forceDismiss() {
        if (failSafeFired) return;
        failSafeFired = true;
        var splash = document.getElementById('splashScreen');
        var lobby = document.getElementById('lobbyScreen');
        var tapBtn = document.getElementById('splashTapToEnter');
        if (tapBtn) tapBtn.style.display = 'none';
        if (splash && lobby && window.getComputedStyle(lobby).display === 'none') {
          splash.classList.add('hidden');
          lobby.classList.remove('hidden');
          lobby.style.display = 'flex';
          lobby.style.opacity = '1';
          lobby.style.transform = 'none';
          lobby.style.pointerEvents = 'auto';
          document.body.dataset.screen = 'lobby';
        }
        // If game-v2.js hasn't loaded yet, initLobby() won't exist.
        // Poll until it does, then wire up the listeners.
        if (typeof initLobby === 'function') {
          initLobby();
        } else {
          var pollInit = setInterval(function() {
            if (typeof initLobby === 'function') {
              clearInterval(pollInit);
              initLobby();
            }
          }, 100);
          // Stop polling after 15 seconds
          setTimeout(function() { clearInterval(pollInit); }, 15000);
        }
      }

      // Auto-dismiss after 5 seconds
      var autoTimer = setTimeout(forceDismiss, 5000);

      // Tap ANYWHERE to skip splash immediately
      document.addEventListener('DOMContentLoaded', function() {
        document.body.addEventListener('touchstart', function(e) {
          clearTimeout(autoTimer);
          forceDismiss();
        }, { once: true, passive: true });
        document.body.addEventListener('click', function(e) {
          clearTimeout(autoTimer);
          forceDismiss();
        }, { once: true, passive: true });
      });

      // Poll for lobby availability every 200ms (handles game-v2.js delayed load)
      var pollTimer = setInterval(function() {
        var lobby = document.getElementById('lobbyScreen');
        if (lobby && window.getComputedStyle(lobby).display !== 'none') {
          clearInterval(pollTimer);
          clearTimeout(autoTimer);
          failSafeFired = true;
        }
      }, 200);
      // Stop polling after 10 seconds
      setTimeout(function() { clearInterval(pollTimer); }, 10000);
    })();
  </script>
</head>
<body data-screen="splash" data-theme="classic">
  <canvas id="themePatternCanvas" aria-hidden="true"></canvas>

  <!-- ====== SPLASH ====== -->
  <div id="splashScreen" class="screen">
    <div class="splash-content">
      <div class="splash-signal-ring"></div>
      <div class="splash-signal-ring"></div>
      <div class="splash-signal-ring"></div>
      <div class="splash-logo">
        <div class="splash-icon">📡</div>
        <h1 class="splash-title">Signal Lost</h1>
        <p class="splash-subtitle">v2</p>
      </div>
      <div class="splash-version">v2.0.0</div>
      <div class="splash-loading-bar">
        <div id="splashLoadingFill" class="splash-loading-fill"></div>
      </div>
      <div id="splashProgressText" class="splash-progress-text">Initializing…</div>
      <div id="splashTapToEnter" class="splash-tap-prompt">⬆ TAP TO ENTER</div>
      <div id="splashKeyHint" class="splash-key-hint">Press any key or click to continue</div>
    </div>
  </div>

  <!-- ====== TUTORIAL ====== -->
  <div id="tutorialScreen" class="screen"></div>

  <!-- ====== LOBBY ====== -->
  <div id="lobbyScreen" class="screen">
    <header class="lobby-header">
      <h1>Signal Lost</h1>
      <p class="tagline">Coordinate. Decode. Extract.</p>
    </header>
    <main class="lobby-grid">
      <section class="card host-card">
        <h2>Host a Game</h2>
        <p>Create a new mission and invite your squad.</p>
        <div class="input-group">
          <label for="hostName">Name</label>
          <input id="hostName" type="text" placeholder="Morgan" maxlength="22">
        </div>
        <div class="input-group">
          <label for="hostCallsign">Callsign</label>
          <input id="hostCallsign" type="text" placeholder="Raven" maxlength="14">
        </div>
        <button id="hostGame" class="primary-button">Host Mission</button>
      </section>
      <section class="card join-card">
        <h2>Join a Game</h2>
        <p>Enter a mission code to link up.</p>
        <div class="input-group">
          <label for="joinCode">Mission Code</label>
          <input id="joinCode" type="text" placeholder="AQUA-RADAR-42" maxlength="40">
          <small id="accessCodeHint" class="access-code-hint hidden">Access code required</small>
        </div>
        <div class="input-group">
          <label for="joinName">Your Name</label>
          <input id="joinName" type="text" placeholder="Agent" maxlength="22">
        </div>
        <div class="input-group">
          <label for="joinCallsign">Callsign</label>
          <input id="joinCallsign" type="text" placeholder="Ghost" maxlength="14">
        </div>
        <button id="joinGame" class="primary-button">Link Up</button>
      </section>
      <section class="card spectate-card">
        <h2>👁 Spectate</h2>
        <p>Watch a live mission without GPS.</p>
        <div class="input-group">
          <label for="spectateCode">Mission Code</label>
          <input id="spectateCode" type="text" placeholder="AQUA-RADAR-42" maxlength="40">
        </div>
        <button id="spectateGame" class="primary-button ghost-button">Enter Spectator</button>
      </section>
    </main>
    <section class="lobby-chat-card card">
      <div class="lobby-chat-header">
        <h3>📡 Squad Comms</h3>
        <span id="lobbyChatBadge" class="lobby-chat-badge hidden">0</span>
      </div>
      <div id="lobbyChatLog" class="lobby-chat-log"></div>
      <form id="lobbyChatForm" class="lobby-chat-form">
        <input id="lobbyChatInput" type="text" placeholder="Message squad…" maxlength="140" autocomplete="off">
        <button type="submit" class="compact-button">Send</button>
      </form>
    </section>
    <footer class="lobby-footer">
      <div id="httpWarning" class="warning-pill hidden">GPS requires HTTPS or localhost</div>
      <div class="theme-bar">
        <button data-theme-palette="classic" class="theme-chip selected">Classic</button>
        <button data-theme-palette="sunset" class="theme-chip">Sunset</button>
        <button data-theme-palette="signal" class="theme-chip">Signal</button>
        <button data-theme-palette="night" class="theme-chip">Night</button>
      </div>
    </footer>
  </div>

  <!-- ====== SETUP ====== -->
  <div id="setupScreen" class="screen">
    <header class="setup-header">
      <button id="backToLobby" class="ghost-button">← Lobby</button>
      <h2>Mission Setup</h2>
      <span id="setupCode" class="code-pill">AQUA-RADAR-42</span>
    </header>
    <main class="setup-main">
      <section class="setup-col">
        <div class="card">
          <h3>Location <button id="locMapMode" class="ghost-button" style="font-size:11px;padding:2px 8px;margin-left:auto" title="Click map to set custom location">📍 Pick on map</button></h3>
          <div class="input-row">
            <div class="input-group">
              <label for="setupCountry">Country</label>
              <select id="setupCountry"></select>
            </div>
            <div class="input-group">
              <label for="setupCity">City</label>
              <select id="setupCity"></select>
            </div>
          </div>
          <div id="customLocationInfo" style="margin-top:8px;font-size:12px;color:#ffd965;display:none;align-items:center;gap:6px">
            <span>📍</span>
            <span id="customLocationCoords"></span>
            <button id="clearCustomLocation" class="ghost-button" style="font-size:11px;padding:2px 6px">✕ Clear</button>
          </div>
          <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap">
            <button id="saveFavoriteLocation" class="compact-button" title="Save current location as favorite">⭐ Save as Favorite</button>
            <select id="loadFavoriteLocation" style="flex:1;min-width:100px;background:#161b22;color:#c9d1d9;border:1px solid #1e2a3a;border-radius:6px;padding:4px 8px;font-size:12px">
              <option value="">— Favorites —</option>
            </select>
            <button id="setDefaultLocation" class="compact-button" title="Set as default for new games">📌 Set Default</button>
            <button id="clearDefaultLocation" class="compact-button danger-button" title="Clear default location">✕</button>
          </div>
        </div>
        <div class="card">
          <h3>Mission Parameters</h3>
          <div class="input-group">
            <label for="setupDuration">Duration: <b id="setupDurationValue">60 min</b></label>
            <input id="setupDuration" type="range" min="30" max="120" value="60">
          </div>
          <div class="input-group">
            <label for="setupPlayers">Squad Size: <b id="setupPlayersValue">6 players</b></label>
            <input id="setupPlayers" type="range" min="2" max="8" value="6">
          </div>
          <div class="input-row toggles">
            <label class="toggle">
              <input id="setupPublic" type="checkbox">
              <span>Public Lobby</span>
            </label>
          </div>
        </div>
        <div class="card">
          <h3>Mission Packs</h3>
          <div id="moduleList" class="module-grid"></div>
        </div>
        <div class="card">
          <h3>Theme</h3>
          <div class="theme-bar">
            <button data-theme-palette="classic" class="theme-chip selected">Classic</button>
            <button data-theme-palette="sunset" class="theme-chip">Sunset</button>
            <button data-theme-palette="signal" class="theme-chip">Signal</button>
            <button data-theme-palette="night" class="theme-chip">Night</button>
          </div>
        </div>
      </section>
      <section class="setup-col wide">
        <div class="card map-card">
          <h3>Marker Placement <small>Click map to add markers</small></h3>
          <div id="setupMap" class="map-container"></div>
          <div class="marker-toolbar">
            <input id="markerLat" type="hidden" value="">
            <input id="markerLng" type="hidden" value="">
            <select id="markerType">
              <option value="Clue">Clue</option>
              <option value="Cache">Cache</option>
              <option value="Waypoint">Waypoint</option>
              <option value="Danger">Danger</option>
              <option value="Extraction">Extraction</option>
            </select>
            <input id="markerTitle" type="text" placeholder="Marker title">
            <button id="addMarker" class="compact-button">Add</button>
            <button id="clearMarkers" class="compact-button danger-button">Clear</button>
          </div>
          <div id="markerList" class="marker-list"></div>
        </div>
      </section>
    </main>
    <footer class="setup-footer">
      <button id="launchMission" class="primary-button large">Launch Mission</button>
    </footer>
  </div>

  <!-- ====== ROLES ====== -->
  <div id="rolesScreen" class="screen">
    <header class="setup-header">
      <button id="backToSetup" class="ghost-button">← Setup</button>
      <h2>Choose Your Role</h2>
      <span id="rolesCode" class="code-pill">CODE</span>
    </header>
    <main class="roles-main">
      <div class="card">
        <h3>Agents on Mission <span id="rosterTeamBadge" class="team-badge hidden"></span></h3>
        <div id="rosterList" class="roster-list"></div>
      </div>
      <div class="role-grid" id="roleGrid">
        <!-- 7 role cards generated by JS -->
      </div>
    </main>
    <footer class="setup-footer">
      <button id="spectateFromRoles" class="ghost-button large">👁 Spectate</button>
      <button id="readyToMission" class="primary-button large">Ready → Launch</button>
    </footer>
  </div>

  <!-- ====== LOADOUT ====== -->
  <div id="loadoutScreen" class="screen">
    <header class="setup-header">
      <button id="loadoutBackBtn" class="ghost-button">← Roles</button>
      <h2>Equip Your Kit</h2>
      <span id="loadoutCode" class="code-pill">CODE</span>
    </header>
    <main class="loadout-main">
      <div id="loadoutPlayerInfo" class="loadout-player-info">Agent — selecting role...</div>

      <div id="loadoutPresets" class="loadout-presets">
        <!-- Preset buttons generated by JS -->
      </div>

      <section class="loadout-section">
        <h3>🎒 Starting Gear <span class="loadout-hint">(choose one)</span></h3>
        <div id="loadoutGearCards" class="loadout-grid loadout-gear-grid">
          <!-- Gear cards generated by JS -->
        </div>
      </section>

      <section class="loadout-section">
        <h3>🔋 Consumables <span class="loadout-hint">(pick 2)</span></h3>
        <div id="loadoutConsumableSlots" class="loadout-grid loadout-consumable-grid">
          <!-- Consumable cards generated by JS -->
        </div>
      </section>

      <section class="loadout-section">
        <h3>🎨 Cosmetics <span class="loadout-hint">(unlocked from Role XP)</span></h3>
        <div id="loadoutCosmeticSlots" class="loadout-grid loadout-cosmetic-grid">
          <!-- Cosmetic cards generated by JS -->
        </div>
      </section>

      <section class="loadout-section">
        <h3>✨ Role Starting Bonus</h3>
        <div id="loadoutRoleBonus" class="loadout-role-bonus">
          <!-- Auto-assigned based on role, shown as read-only -->
        </div>
      </section>

      <div id="loadoutReadyList" class="loadout-ready-list">
        <!-- Shows which players have confirmed -->
      </div>
    </main>
    <footer class="setup-footer">
      <button id="loadoutConfirmBtn" class="primary-button large">✅ Confirm Loadout</button>
    </footer>
  </div>

  <!-- ====== BRIEFING ====== -->
  <div id="briefingScreen" class="screen">
    <header class="setup-header">
      <button id="backToRoles" class="ghost-button">← Roles</button>
      <h2>Mission Briefing</h2>
      <span id="briefingCode" class="code-pill">CODE</span>
    </header>
    <main class="briefing-main">
      <section class="briefing-col">
        <div class="card">
          <h3>📍 Area Overview</h3>
          <div id="briefingMap" class="map-container"></div>
          <div class="briefing-meta">
            <div class="meta-pill"><span>Location</span><b id="briefingLocation">--</b></div>
            <div class="meta-pill"><span>Duration</span><b id="briefingDuration">--</b></div>
            <div class="meta-pill"><span>Squad</span><b id="briefingSquadSize">--</b></div>
          </div>
        </div>
        <div class="card">
          <h3>👥 Squad Roster</h3>
          <div id="briefingRoster" class="briefing-roster"></div>
        </div>
      </section>
      <section class="briefing-col">
        <div class="card">
          <h3>🎯 Objectives <span id="briefingObjCount" class="obj-count-badge">0</span></h3>
          <div id="briefingObjectives" class="briefing-objectives"></div>
        </div>
        <div class="card">
          <h3>⚠️ Threat Assessment</h3>
          <div id="briefingThreats" class="briefing-threats"></div>
        </div>
      </section>
    </main>
    <footer class="setup-footer">
      <button id="deployMission" class="primary-button large">🚀 Deploy to Mission</button>
    </footer>
  </div>

  <!-- ====== MISSION ====== -->
  <div id="missionScreen" class="screen">
    <div id="missionMap" class="mission-map"></div>

    <!-- Radar Canvas Overlay -->
    <canvas id="missionRadar" width="160" height="160"></canvas>

    <!-- Compass Rose Overlay -->
    <canvas id="compassRose" width="160" height="160"></canvas>

    <!-- Particle Effects Canvas Overlay -->
    <canvas id="particleCanvas" class="particle-canvas"></canvas>

    <!-- Fog of War Canvas Overlay -->
    <canvas id="fogCanvas" class="fog-canvas"></canvas>

    <!-- Command Wheel Canvas Overlay -->
    <canvas id="commandWheel" class="command-wheel"></canvas>

    <!-- Floating GPS Button (mobile) -->
    <button id="floatingGpsBtn" class="floating-gps-btn" title="Focus GPS">📍</button>

    <!-- Panel Drawer Overlay (mobile) -->
    <div id="panelDrawerOverlay" class="panel-drawer-overlay hidden"></div>

    <!-- Mobile Comms Mini-Bar (shows when drawer is closed) -->
    <div id="commsMiniBar" class="comms-mini-bar">
      <div class="cmb-msg" id="cmbMsg"><span class="cmb-sender">System</span>Ready to deploy</div>
      <button class="cmb-btn" id="cmbPanelsBtn" title="Open Panels">📋</button>
      <button class="cmb-btn cmb-primary" id="cmbVoiceBtn" title="Voice Comms">🎙️</button>
    </div>

    <!-- Threat Proximity Vignette -->
    <div id="threatVignette" class="threat-vignette"></div>
    <div id="threatGlow" class="threat-glow"></div>
    <div id="threatIndicatorTop" class="threat-indicator" style="top:60px;left:50%;transform:translateX(-50%);"></div>
    <div id="threatIndicatorBottom" class="threat-indicator" style="bottom:60px;left:50%;transform:translateX(-50%);"></div>
    <div id="threatIndicatorLeft" class="threat-indicator" style="top:50%;left:8px;transform:translateY(-50%);"></div>
    <div id="threatIndicatorRight" class="threat-indicator" style="top:50%;right:8px;transform:translateY(-50%);"></div>
    <div id="threatDirectionArrow" class="threat-direction-arrow"></div>

    <!-- FPS Debug Overlay -->
    <div id="fpsDebugOverlay" class="fps-debug-overlay hidden">FPS: --</div>

    <!-- Event Log / Kill Feed Overlay -->
    <div id="eventLogOverlay" class="event-log-overlay"></div>

    <!-- Downed Alert Overlay -->
    <div id="downedAlert" class="downed-alert hidden">
      <div class="downed-title">🚨 YOU ARE DOWNED</div>
      <div class="downed-timer">Revive in <span id="downedCountdown">60</span>s</div>
      <div class="downed-hint">A Medic can revive you faster. Stay close to squad.</div>
    </div>

    <!-- Revive Prompt (shown when near downed squadmate) -->
    <div id="revivePrompt" class="revive-prompt hidden"></div>

    <!-- Extraction progress overlay -->
    <div id="extractionOverlay" class="extraction-overlay hidden">
      <div class="extraction-bar-container">
        <div class="extraction-bar-label">EXTRACTING</div>
        <div class="extraction-bar-track"><div id="extractionProgress" class="extraction-bar-fill" style="width:0%"></div></div>
        <div class="extraction-clock-wrap">
          <svg class="extraction-clock-svg" viewBox="0 0 40 40">
            <circle class="extraction-clock-bg" cx="20" cy="20" r="18"/>
            <circle id="extractionClockRing" class="extraction-clock-ring" cx="20" cy="20" r="18"/>
          </svg>
          <div id="extractionTimer" class="extraction-timer">15</div>
        </div>
      </div>
    </div>

    <header class="mission-hud">
      <div class="hud-left">
        <span id="missionTimer" class="timer">60:00</span>
        <span id="missionStatus" class="status-pill">Live</span>
        <span id="latencyBadge" class="latency-badge" title="Network latency">--ms</span>
        <span id="weatherHUD" class="weather-hud" title="Current weather conditions">☀️ Clear</span>
        <span id="latencyBadge" class="latency-badge" title="Network latency">--ms</span>
        <span id="dayNightIndicator" class="day-night-indicator" data-phase="night">
          <span class="dn-icon">🌙</span><span class="dn-label">NIGHT</span>
        </span>
      </div>
      <div id="progressionHUD" class="progression-hud" title="Role progression">
        <span class="tier-badge tier-1">T1</span>
        <span class="xp-bar"><span class="xp-fill" style="width:0%"></span></span>
        <span class="xp-text">0 XP</span>
      </div>
      <div class="hud-center">
        <!-- Supply Cache HUD -->
        <div id="supplyCacheHUD" class="supply-cache-hud hidden"></div>
        <!-- Terrain HUD -->
        <div id="terrainHUD" class="terrain-hud" title="Current terrain">Open</div>
        <div class="hud-bars">
          <div class="hud-bar-row">
            <span class="hud-bar-label">SIG</span>
            <div class="hud-bar-track"><div id="hudSignalBar" class="hud-bar-fill signal-fill" style="width:72%"></div></div>
          </div>
          <div class="hud-bar-row">
            <span class="hud-bar-label">STA</span>
            <div class="hud-bar-track"><div id="hudStaminaBar" class="hud-bar-fill stamina-fill" style="width:85%"></div></div>
          </div>
        </div>
        <!-- Team Voice Indicators (4.3) -->
        <div id="voiceIndicatorBar" class="voice-indicator-bar"></div>
      </div>
      <div class="hud-right">
        <span id="spectatorCountIndicator" class="spectator-count-indicator hidden" title="Spectators watching">👁 0</span>
        <button id="focusGps" class="icon-button" title="GPS Focus">🎯</button>
        <button id="togglePanels" class="icon-button" title="Panels">📋</button>
        <div id="hudOverflow" class="hud-overflow">
          <button id="hudOverflowToggle" class="icon-button overflow-toggle" title="More">•••</button>
          <div id="hudOverflowMenu" class="hud-overflow-menu">
            <button id="toggleVoice" class="icon-button voice-button" title="Push to Talk">🎙️</button>
            <button id="toggleStealth" class="icon-button stealth-button" title="Enter Stealth">🥷</button>
            <button id="toggleRadar" class="icon-button" title="Toggle Radar">📡</button>
            <button id="fullscreenRadar" class="icon-button" title="Full Radar">🔄</button>
            <div class="hud-overflow-separator"></div>
            <button id="endMissionBtn" class="icon-button danger-icon" title="End Mission">⏹</button>
          </div>
        </div>
      </div>
    </header>

    <!-- Ability Hotbar (2.2) -->
    <div id="abilityHotbar" class="ability-hotbar"></div>
    <!-- Trap Selector (Phase 4 Task 4) -->
    <div id="trapSelector" class="trap-selector hidden">
      <button class="trap-btn" data-trap="mine" title="Proximity Mine">💥 Mine</button>
      <button class="trap-btn" data-trap="flare" title="Trip Flare">🔦 Flare</button>
      <button class="trap-btn" data-trap="decoy" title="Decoy Signal">📡 Decoy</button>
      <span class="trap-charges">Charges: <span id="trapCharges">2</span></span>
    </div>
    <!-- Drone Bar (4.0) -->
    <div id="droneBar" class="drone-bar hidden">
      <button class="drone-btn" data-drone="scout" title="Scout Drone (120s)">🛸 Scout</button>
      <button class="drone-btn" data-drone="decoy" title="Decoy Drone (15s)">🎯 Decoy</button>
      <button class="drone-btn" data-drone="shield" title="Shield Drone (30s)">🛡️ Shield</button>
      <span class="drone-charge">Charges: <span id="droneCharges">1</span></span>
    </div>
    <!-- Drone HUD -->
    <div id="droneHUD" class="drone-hud hidden">
      <div id="droneStatus" class="drone-status">No drone active</div>
      <div id="droneBatteryBar" class="drone-battery-bar"><div class="drone-battery-fill" style="width:0%"></div></div>
    </div>
    <!-- Active Buffs (2.2) -->
    <div id="activeBuffs" class="active-buffs"></div>

    <!-- Map Legend (2.3) -->
    <div id="mapLegend" class="map-legend">
      <button id="mapLegendToggle" class="map-legend-toggle" title="Toggle Legend">❔</button>
      <div id="mapLegendContent" class="map-legend-content">
        <div class="map-legend-title">Legend</div>
        <div class="map-legend-item">
          <span class="map-legend-icon map-legend-pulse" style="background:#00bcd4;border:2px solid #fff;"></span>
          <span class="map-legend-label">You</span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-icon" style="background:#4fc3f7;border:2px solid #ffd965;"></span>
          <span class="map-legend-label">Squad North</span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-icon" style="background:#ff8a65;border:2px solid #ffd965;"></span>
          <span class="map-legend-label">Squad South</span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-icon" style="background:#ff8b1f;border:2px solid #fff;"></span>
          <span class="map-legend-label">Objective</span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-icon" style="background:#4caf50;border:2px solid #81c784;"></span>
          <span class="map-legend-label">Objective Found</span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-icon" style="background:#555;border:2px solid #777;"></span>
          <span class="map-legend-label">Locked</span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-icon" style="background:#ef4444;border:2px solid #fff;"></span>
          <span class="map-legend-label">Threat</span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-icon" style="background:linear-gradient(135deg,#00e676,#00c853);border:2px solid #fff;"></span>
          <span class="map-legend-label">Extraction</span>
        </div>
      </div>
    </div>

    <aside id="missionPanels" class="mission-panels">
      <div class="panel-tabs">
        <button data-panel-tab="objectives" class="panel-tab active">Objectives</button>
        <button data-panel-tab="comms" class="panel-tab">Comms</button>
        <button data-panel-tab="role" class="panel-tab">Role</button>
        <button data-panel-tab="gps" class="panel-tab">GPS</button>
      </div>
      <div class="panel-content">
        <div data-panel-view="objectives" class="panel-view active">
          <div class="panel-view-header">
            <h4>Objectives <span id="objCount">0/0</span></h4>
          </div>
          <div id="objectiveList" class="scroll-list"></div>
        </div>
        <div data-panel-view="comms" class="panel-view">
          <div class="panel-view-header">
            <h4>Comms</h4>
          </div>
          <!-- Voice Squad List (4.3) -->
          <div id="voiceSquadList" class="voice-squad-list"></div>
          <div id="chatLog" class="chat-log"></div>
          <form id="chatForm" class="chat-form">
            <input id="chatInput" type="text" placeholder="Message…" maxlength="140" autocomplete="off">
            <button type="submit" class="compact-button">Send</button>
          </form>
        </div>
        <div data-panel-view="radar" class="panel-view">
          <div class="panel-view-header">
            <h4>Radar <small style="font-weight:400;color:var(--text-dim)">filter what shows on radar</small></h4>
          </div>
          <div id="radarFilterContent" class="radar-filter-content">
            <div class="input-group">
              <label>Radar Range</label>
              <input id="radarRangeSlider" type="range" min="50" max="500" value="200">
              <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text-dim);margin-top:2px">
                <span>50m</span><span id="radarRangeLabel">200m</span><span>500m</span>
              </div>
            </div>
            <div class="radar-filter-toggles">
              <label class="radar-filter-chip active" data-filter="objectives">📍 Objectives</label>
              <label class="radar-filter-chip active" data-filter="agents">👤 Agents</label>
              <label class="radar-filter-chip active" data-filter="threats">⚠ Threats</label>
              <label class="radar-filter-chip active" data-filter="pings">📡 Pings</label>
              <label class="radar-filter-chip active" data-filter="waypoints">🔷 Waypoints</label>
            </div>
            <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
              <button id="radarToggleBtn" class="compact-button">Toggle Radar</button>
              <button id="radarFullscreenBtn" class="compact-button">Fullscreen</button>
              <button id="radarResetBtn" class="compact-button ghost-button">Reset All</button>
            </div>
          </div>
        </div>
        <div data-panel-view="role" class="panel-view">
          <div class="panel-view-header">
            <h4 id="roleTitle">Role</h4>
          </div>
          <div id="roleTools" class="tool-grid"></div>
        </div>
        <div data-panel-view="gps" class="panel-view">
          <div class="panel-view-header">
            <h4>GPS</h4>
          </div>
          <button id="startGps" class="compact-button">Start GPS</button>
          <button id="stopGps" class="compact-button danger-button">Stop GPS</button>
          <div class="input-row">
            <input id="manualLat" type="number" step="0.0001" placeholder="Lat">
            <input id="manualLng" type="number" step="0.0001" placeholder="Lng">
          </div>
          <button id="applyManualGps" class="compact-button">Apply Manual</button>
          <div id="gpsStatus" class="gps-status">GPS standby</div>
          <div class="battery-gps-divider"></div>
          <div class="battery-gps-row">
            <div id="batteryGpsStatus" class="battery-gps-status">🔋 -- · Normal</div>
            <button id="toggleBatterySaver" class="compact-button battery-saver-btn">Saver: OFF</button>
          </div>
        </div>
      </div>
      <!-- Drag handle for mobile drawer -->
      <div class="drawer-handle"><span></span></div>
    </aside>

    <div id="confirmEndDialog" class="confirm-dialog hidden">
      <div class="confirm-dialog-content">
        <h4>End Mission?</h4>
        <p>This will conclude the current operation.</p>
        <div class="confirm-dialog-actions">
          <button id="confirmEndYes" class="danger-button">End Mission</button>
          <button id="confirmEndNo" class="ghost-button">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ====== SPECTATOR ====== -->
  <div id="spectatorScreen" class="screen">
    <div id="spectatorMap" class="spectator-map"></div>
    <header class="spectator-hud">
      <div class="spectator-hud-left">
        <span class="spectator-badge">👁 Spectator</span>
        <span id="spectatorCode" class="code-pill">AQUA-RADAR-42</span>
      </div>
      <div class="spectator-hud-center">
        <span id="spectatorTimer" class="timer">60:00</span>
        <span id="spectatorStatus" class="status-pill">Live</span>
      </div>
      <div class="spectator-hud-right">
        <button id="spectatorTogglePanels" class="icon-button" title="Toggle Panels">📋</button>
        <button id="spectatorLeave" class="icon-button danger-icon" title="Leave">⏹</button>
      </div>
    </header>
    <aside id="spectatorPanels" class="spectator-panels">
      <div class="panel-tabs">
        <button data-spectator-tab="agents" class="panel-tab active">Agents</button>
        <button data-spectator-tab="objectives" class="panel-tab">Objectives</button>
        <button data-spectator-tab="comms" class="panel-tab">Comms</button>
        <button data-spectator-tab="threats" class="panel-tab">Threats</button>
      </div>
      <div class="panel-content">
        <div data-spectator-view="agents" class="panel-view active">
          <div class="panel-view-header"><h4>Live Agents</h4></div>
          <div id="spectatorAgentList" class="scroll-list"></div>
        </div>
        <div data-spectator-view="objectives" class="panel-view">
          <div class="panel-view-header"><h4>Objectives <span id="spectatorObjCount">0/0</span></h4></div>
          <div id="spectatorObjectiveList" class="scroll-list"></div>
        </div>
        <div data-spectator-view="comms" class="panel-view">
          <div class="panel-view-header"><h4>Comms</h4></div>
          <div id="spectatorChatLog" class="chat-log"></div>
          <form id="spectatorChatForm" class="chat-form">
            <input id="spectatorChatInput" type="text" placeholder="Message…" maxlength="140" autocomplete="off">
            <button type="submit" class="compact-button">Send</button>
          </form>
        </div>
        <div data-spectator-view="threats" class="panel-view">
          <div class="panel-view-header"><h4>Threat Status</h4></div>
          <div id="spectatorThreatList" class="scroll-list"></div>
        </div>
      </div>
      <div class="drawer-handle"><span></span></div>
    </aside>
  </div>

  <!-- ====== REPLAY ====== -->
  <div id="replayScreen" class="screen">
    <header class="replay-header">
      <button id="backToResults" class="ghost-button">← Results</button>
      <h2>Mission Replay</h2>
      <span id="replayCode" class="code-pill">AQUA-RADAR-42</span>
    </header>
    <div id="replayMap" class="replay-map"></div>
    <aside class="replay-sidebar">
      <div class="card">
        <h3>Path Stats</h3>
        <div class="stat-row"><span>Distance</span><b id="replayDistance">--</b></div>
        <div class="stat-row"><span>Waypoints</span><b id="replayWaypoints">--</b></div>
        <div class="stat-row"><span>Avg Speed</span><b id="replayAvgSpeed">--</b></div>
        <div class="stat-row"><span>Time Active</span><b id="replayTimeActive">--</b></div>
      </div>
      <div class="card">
        <h3>Threats Encountered</h3>
        <div id="replayThreatList" class="scroll-list"></div>
      </div>
      <div class="card">
        <h3>Score Breakdown</h3>
        <div class="stat-row"><span>Objectives</span><b id="replayObjScore">--</b></div>
        <div class="stat-row"><span>Progress</span><b id="replayProgScore">--</b></div>
        <div class="stat-row"><span>Time Bonus</span><b id="replayTimeScore">--</b></div>
        <div class="stat-row"><span>Squad</span><b id="replaySquadScore">--</b></div>
        <div class="stat-row"><span>Threat Penalty</span><b id="replayThreatPenalty">--</b></div>
        <div class="stat-row replay-total"><span>Total</span><b id="replayTotalScore">--</b></div>
      </div>
    </aside>
  </div>

  <!-- ====== RESULTS ====== -->
  <div id="resultsScreen" class="screen">
    <canvas id="resultsConfetti" aria-hidden="true"></canvas>
    <header class="results-header">
      <h1>Mission Complete</h1>
      <div id="resultsTrophy" class="results-trophy">🏆</div>
      <div id="scoreGrade" class="grade">B</div>
      <div id="scoreValue" class="score">0</div>
      <p id="scoreSummary" class="score-summary">Objectives found: 0/0</p>
    </header>
    <main class="results-main">
      <div class="card">
        <h3>Squad Stats</h3>
        <div class="stat-row">
          <span>Avg Signal</span><b id="resSignal">--</b>
        </div>
        <div class="stat-row">
          <span>Avg Stamina</span><b id="resStamina">--</b>
        </div>
        <div class="stat-row">
          <span>Time Remaining</span><b id="resTime">--</b>
        </div>
        <div class="stat-row">
          <span>Threat Penalty</span><b id="resThreat">--</b>
        </div>
      </div>
      <div class="card">
        <h3>Team Standings</h3>
        <div id="teamList" class="scroll-list"></div>
      </div>
    </main>
    <footer class="results-footer">
      <button id="playAgain" class="primary-button large">Play Again</button>
      <button id="revealMapRecap" class="ghost-button large">Reveal Map Recap</button>
    </footer>
  </div>

  <div id="offlineIndicator" class="offline-indicator hidden" aria-live="polite">Offline — cached mode</div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="game-v2.js?v=2"></script>
</body>
</html>
